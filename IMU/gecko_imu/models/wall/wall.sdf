<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="gecko_wall">
    <!-- The spawn request supplies the world pose explicitly. -->
    <static>true</static>
    <link name="wall_link">
      <collision name="wall_collision">
        <geometry>
          <box><size>0.10 2.0 2.0</size></box>
        </geometry>
      </collision>
      <visual name="wall_visual">
        <geometry>
          <box><size>0.10 2.0 2.0</size></box>
        </geometry>
        <material>
          <ambient>0.55 0.58 0.62 1</ambient>
          <diffuse>0.65 0.68 0.72 1</diffuse>
          <specular>0.08 0.08 0.08 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
